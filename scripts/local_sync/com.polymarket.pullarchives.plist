<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: replace __HOME__ with your home directory (the install commands in OPERATIONS.md do this). -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.polymarket.pullarchives</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__HOME__/PolymarketData/bin/pull_archives.sh</string>
  </array>
  <key>StartInterval</key><integer>3600</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__HOME__/PolymarketData/launchd.out.log</string>
  <key>StandardErrorPath</key><string>__HOME__/PolymarketData/launchd.err.log</string>
</dict>
</plist>
