[Unit]
Description=Polymarket paper-trading dashboard (uvicorn on 127.0.0.1:8787)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/polymarket-bot/web
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/polymarket-bot/src
ExecStart=/opt/polymarket-bot/.venv/bin/python -m uvicorn app:app --app-dir /opt/polymarket-bot/web --host 127.0.0.1 --port 8787 --log-level warning
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
