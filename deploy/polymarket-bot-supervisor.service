[Unit]
Description=Polymarket paper-trading supervisor (fail-closed)
After=network-online.target time-sync.target
Wants=network-online.target time-sync.target
# systemd Restart=on-failure must never clear data/runtime/HALT.json.
# The supervisor process itself refuses to start trading while the latch is set.

[Service]
Type=simple
User=root
WorkingDirectory=/opt/polymarket-bot
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/opt/polymarket-bot/src
ExecStart=/opt/polymarket-bot/.venv/bin/python -m polymarket_bot.runtime.supervisor --config /opt/polymarket-bot/config.yaml
Restart=on-failure
RestartSec=3
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
